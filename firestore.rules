rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helper functions ───────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isSuperAdmin() {
      return hasRole('admin');
    }

    function isRestaurantAdmin(restaurantId) {
      return hasRole('restaurant_admin') && getUserData().assignedRestaurantId == restaurantId;
    }

    function isRider() {
      return hasRole('rider');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── user rules ─────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'isBlocked', 'assignedRestaurantId']);
      allow delete: if isSuperAdmin();

      match /cart/{cartId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
      match /addresses/{addressId} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
    }

    // ── root collections ───────────────────────────────────────────────────

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || isRestaurantAdmin(restaurantId);

      match /menu/{menuId} {
        allow read: if true;
        allow write: if isSuperAdmin() || isRestaurantAdmin(restaurantId);
      }
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.userId) ||
        isSuperAdmin() ||
        isRestaurantAdmin(resource.data.restaurantId) ||
        (isRider() && resource.data.riderId == request.auth.uid) ||
        (isRider() && resource.data.status == 'Pending')
      );
      allow create: if isSignedIn(); // Allow app to create (usually backend does this, but for now)
      allow update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    match /order_requests/{requestId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /app_config/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isSuperAdmin();
    }

    match /deals/{dealId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /commissions/{commId} {
      allow read, write: if isSuperAdmin();
    }

    match /checkouts/{checkoutId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /wallets/{walletId} {
      allow read: if isSignedIn() && (isOwner(walletId) || isSuperAdmin());
      allow write: if isSuperAdmin();

      match /transactions/{txnId} {
        allow read: if isSignedIn() && (isOwner(walletId) || isSuperAdmin());
        allow write: if isSuperAdmin();
      }
    }

    match /withdrawal_requests/{requestId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }
  }
}
